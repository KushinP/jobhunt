# Cloudflare API token for the PERSONAL account that hosts JobHunt.
# wrangler prefers this over any global login, so your other Cloudflare work is untouched.
#
# Create at: https://dash.cloudflare.com/profile/api-tokens -> Create Token -> Custom token
# Permissions (all Account-scoped):
#   Workers Scripts        Edit
#   Workers KV Storage     Edit
#   D1                     Edit
#   Account Settings       Read
#
# NOTE: this is an API token from the profile page above. It is NOT a Cloudflare Access
# service token (CF-Access-Client-Id / CF-Access-Client-Secret); those authenticate a
# machine THROUGH an Access-protected app and cannot create or deploy anything.
CLOUDFLARE_API_TOKEN=

# Your Cloudflare account id, and the D1 database id that setup-cloudflare.sh printed.
# Both are shown again by: npx wrangler d1 info jobhunt
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
