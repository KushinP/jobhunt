  "output_rules": {
    "build_method": "HARD RULE: build every resume by editing a copy of the base resume .docx from get_base_resume(include_file=true), in place (python-docx or XML edits). Keep its fonts, table layout, section headers, bullet numbering and header block exactly. Never generate a resume from scratch.",
    "verify_before_saving": "Before start_document_upload, check the built file: (1) the GPA line matches gpa_format exactly; (2) no date appears in the Projects section; (3) the file keeps the base's layout; (4) it renders at page_cap pages with LibreOffice. Fix and rebuild if any check fails.",
    "gpa_format": "Always label the GPA: write 'GPA: {{GPA}}/4.0'.",
    "project_dates": "Never show dates on project entries. Project headings are name and description only, with the right-hand date cell left empty. Dates stay on Education, Work Experience and Leadership entries.",
